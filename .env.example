# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default for development):
DATABASE_URL="file:./dev.db"

# PostgreSQL (production):
# DATABASE_URL="postgresql://user:password@host:5432/shopzen?schema=public"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="shopzen-super-secure-jwt-secret-minimum-32-characters"

# ─── Google OAuth (optional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Cashfree Payment Link (UPI / Card / Net Banking) ─────────────────────────
NEXT_PUBLIC_CASHFREE_PAYMENT_LINK="https://cfpe.me/krishnadas"
NEXT_PUBLIC_PAYEE_NAME="DIGITAL MARKETING"

# ─── Email OTP (Nodemailer / Real SMTP) ───────────────────────────────────────
#
# EMAIL_PROVIDER selects a preset that auto-fills SMTP_HOST, SMTP_PORT, and
# SMTP_SECURE. You can still override any value manually.
#
# Supported values: gmail | brevo | resend | custom
#
# ╔════════════════════════════════════════════════════════════════════════════╗
# ║  Development (no SMTP configured)                                          ║
# ║  → OTPs are printed to the server terminal                                 ║
# ║  → A yellow dev banner shows the OTP on the verify screen                 ║
# ║  → The app never crashes; perfect for local dev                            ║
# ╠════════════════════════════════════════════════════════════════════════════╣
# ║  Production (NODE_ENV=production)                                          ║
# ║  → SMTP MUST be configured; if not, /api/auth/register returns HTTP 503   ║
# ║  → The OTP is NEVER printed or returned in any response                   ║
# ╚════════════════════════════════════════════════════════════════════════════╝
#
# ─── Option 1: Gmail (good for testing, ~500 emails/day limit) ────────────────
#
#   STEP-BY-STEP:
#   1. Go to https://myaccount.google.com → Security
#   2. Enable 2-Step Verification
#   3. Under 2-Step Verification → scroll to App passwords
#   4. Create an App password for "Mail" → "Other (Custom name)" → "ShopZen"
#   5. Copy the 16-character code (no spaces) → paste as SMTP_PASS below
#
EMAIL_PROVIDER="gmail"
SMTP_HOST=""                         # auto-filled from preset (smtp.gmail.com)
SMTP_PORT=""                         # auto-filled (587)
SMTP_SECURE=""                       # auto-filled (false for STARTTLS)
SMTP_USER=""                         # your Gmail address e.g. you@gmail.com
SMTP_PASS=""                         # 16-char App Password e.g. abcdabcdabcdabcd
SMTP_FROM="noreply@shopzen.com"      # Sender address shown in the email
SMTP_REPLY_TO="support@shopzen.com"  # Reply-To header

# ─── Option 2: Brevo (formerly Sendinblue – free tier: 300 emails/day) ────────
#
#   1. Create a free account at https://app.brevo.com
#   2. Go to Settings → SMTP & API → SMTP Keys → Generate a new SMTP key
#   3. Verify your sender email in Senders & Domains
#
# EMAIL_PROVIDER="brevo"
# SMTP_HOST=""                       # auto-filled (smtp-relay.brevo.com)
# SMTP_PORT=""                       # auto-filled (587)
# SMTP_USER="your-brevo-login@email.com"
# SMTP_PASS="<brevo-smtp-key>"

# ─── Option 3: Resend (generous free tier, excellent deliverability) ──────────
#
#   1. Create an account at https://resend.com
#   2. Add & verify your domain (for production) or use their sandbox
#   3. Go to API Keys → Create API key
#   4. SMTP user is always literally "resend"; SMTP_PASS = API key
#
# EMAIL_PROVIDER="resend"
# SMTP_HOST=""                       # auto-filled (smtp.resend.com)
# SMTP_PORT=""                       # auto-filled (465, TLS)
# SMTP_USER=""                       # auto-filled ("resend")
# SMTP_PASS="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"  # your Resend API key
# SMTP_FROM="noreply@yourdomain.com"           # must be a verified Resend domain

# ─── Option 4: Custom SMTP ────────────────────────────────────────────────────
#
# EMAIL_PROVIDER="custom"
# SMTP_HOST="smtp.yourprovider.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"                # true for port 465 (implicit TLS)
# SMTP_USER="your@email.com"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="noreply@yourdomain.com"

# ─── App Settings ─────────────────────────────────────────────────────────────
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="5242880"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ShopZen"
NEXT_PUBLIC_CURRENCY="INR"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"

# ─── Deployment Note ──────────────────────────────────────────────────────────
# When deploying to Vercel, Railway, Render, or any other host, you MUST add
# all SMTP_* and EMAIL_PROVIDER variables to your hosting dashboard's
# environment variable settings. Without them, NODE_ENV=production and SMTP
# unconfigured means every registration returns HTTP 503.
